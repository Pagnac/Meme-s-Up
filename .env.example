# Configuration Firebase (mode en ligne).
# 1) Crée un projet sur https://console.firebase.google.com (gratuit, plan Spark)
# 2) Ajoute une app Web et copie les valeurs dans un fichier .env.local
# 3) Active Firestore Database (mode test ou règles du fichier firestore.rules)
# Sans ces valeurs, l'app fonctionne en mode local uniquement.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
